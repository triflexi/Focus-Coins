        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "stake"
                ],
                "properties": {
                  "stake": {
                    "type": "string",
                    "pattern": "^\\d+(\\.\\d{1,2})?$"
                  },
                  "bet": {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "enum": [
                          "red",
                          "black",
                          "even",
                          "odd",
                          "number"
                        ]
                      },
                      "number": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 36
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
