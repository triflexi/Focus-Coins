  "info": {
    "title": "Focus Coins API",
    "description": "",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "Session": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "minutes": {
            "type": "integer"
          },
          "startedAt": {
            "type": "string"
          },
          "endsAt": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "reward": {
            "type": "string",
            "pattern": "^-?\\d+\\.\\d{2}$",
            "example": "100.00"
          },
          "multiplier": {
            "type": "number"
          }
        },
        "required": [
          "id",
          "minutes",
          "startedAt",
          "endsAt",
          "status",
          "reward",
          "multiplier"
        ]
      },
      "Round": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "stake": {
            "type": "string",
            "pattern": "^-?\\d+\\.\\d{2}$",
            "example": "100.00"
          },
          "payout": {
            "type": "string",
            "pattern": "^-?\\d+\\.\\d{2}$",
            "example": "100.00"
          },
          "net": {
            "type": "string",
            "pattern": "^-?\\d+\\.\\d{2}$",
            "example": "100.00"
          },
          "status": {
            "type": "string"
          },
          "result": {
            "type": "object",
            "additionalProperties": true
          },
          "floors": {
            "type": "integer"
          },
          "picks": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "expiresAt": {
            "type": "string"
          },
          "createdAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind",
          "stake",
          "payout",
          "net",
          "status",
          "result",
          "floors",
          "picks",
          "expiresAt",
          "createdAt"
        ]
      },
      "Dashboard": {
        "type": "object",
        "properties": {
          "serverTime": {
            "type": "string"
          },
          "user": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "login": {
                "type": "string"
              },
              "nickname": {
                "type": "string"
              },
              "createdAt": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "login",
              "nickname",
              "createdAt"
            ]
          },
          "season": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string"
              },
              "endsAt": {
                "type": "string"
              }
            },
            "required": [
              "key",
              "endsAt"
            ]
          },
          "balance": {
            "type": "string",
            "pattern": "^-?\\d+\\.\\d{2}$",
            "example": "100.00"
          },
          "reserved": {
            "type": "string",
            "pattern": "^-?\\d+\\.\\d{2}$",
            "example": "100.00"
          },
          "rankingBalance": {
            "type": "string",
            "pattern": "^-?\\d+\\.\\d{2}$",
            "example": "100.00"
          },
          "rank": {
            "type": "integer"
          },
          "active": {
            "nullable": true,
            "allOf": [
              {
                "$ref": "#/components/schemas/Session"
              }
            ]
          },
          "history": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Session"
            }
          },
          "rounds": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Round"
            }
          },
          "tower": {
            "nullable": true,
            "allOf": [
              {
                "$ref": "#/components/schemas/Round"
              }
            ]
          },
          "daily": {
            "type": "object",
            "properties": {
              "minutes": {
                "type": "integer"
              },
              "streak": {
                "type": "integer"
              },
              "cycle": {
                "type": "integer"
              },
              "awarded": {
                "type": "boolean"
              },
              "boostUntil": {
                "type": "string",
                "nullable": true
              }
            },
            "required": [
              "minutes",
              "streak",
              "cycle",
              "awarded",
              "boostUntil"
            ]
          },
          "stats": {
            "type": "object",
            "properties": {
              "totalMinutes": {
                "type": "integer"
              },
              "weekMinutes": {
                "type": "integer"
              },
              "monthMinutes": {
                "type": "integer"
              },
              "completed": {
                "type": "integer"
              },
              "cancelled": {
                "type": "integer"
              },
              "focusCoins": {
                "type": "string",
                "pattern": "^-?\\d+\\.\\d{2}$",
                "example": "100.00"
              },
              "bonusCoins": {
                "type": "string",
                "pattern": "^-?\\d+\\.\\d{2}$",
                "example": "100.00"
              },
              "gameNet": {
                "type": "string",
                "pattern": "^-?\\d+\\.\\d{2}$",
                "example": "100.00"
              },
              "days": {
                "type": "array",
