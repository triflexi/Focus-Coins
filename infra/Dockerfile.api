FROM node:22-bookworm-slim AS build
RUN apt-get update && apt-get install -y --no-install-recommends openssl && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY . .
RUN npm ci --workspace @focus/api --workspace @focus/core --include-workspace-root && npm run db:generate && npm run build -w @focus/core && npm run build -w @focus/api
FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends openssl && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /app/package.json /app/package-lock.json ./
COPY --from=build /app/packages/core ./packages/core
COPY --from=build /app/apps/api ./apps/api
RUN npm ci --omit=dev --workspace @focus/api --workspace @focus/core && npm run db:generate -w @focus/api && npm cache clean --force
USER node
WORKDIR /app/apps/api
EXPOSE 3000
CMD ["sh", "-c", "node prisma/cli.mjs migrate deploy && node dist/main.js"]
